<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_ai_erp_dashboard" model="ir.actions.act_window">
            <field name="name">AI-powered ERP Dashboard &amp; Workflow Automation Suite</field>
            <field name="res_model">ai.erp.kpi</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_ai_erp_dashboard_tree" model="ir.ui.view">
            <field name="name">ai.erp.kpi.tree</field>
            <field name="model">ai.erp.kpi</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_ai_erp_dashboard_form" model="ir.ui.view">
            <field name="name">ai.erp.kpi.form</field>
            <field name="model">ai.erp.kpi</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ai_erp_dashboard_menu_root" model="ir.ui.menu">
            <field name="name">AI ERP</field>
            <field name="sequence">51</field>
        </record>

        <record id="ai_erp_dashboard_menu" model="ir.ui.menu">
            <field name="name">ERP Dashboard</field>
            <field name="parent_id" ref="ai_erp_dashboard_menu_root"/>
            <field name="action" ref="action_ai_erp_dashboard"/>
            <field name="sequence">10</field>
        </record>
    </data>
</odoo>
